# Stage 1: Build
FROM rust:1.98-slim AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache dependency resolution: copy manifests first
COPY Cargo.toml Cargo.lock ./
COPY shared/Cargo.toml shared/Cargo.toml
COPY server/Cargo.toml server/Cargo.toml
COPY client/Cargo.toml client/Cargo.toml

# Create dummy source files so cargo can resolve all workspace members
RUN mkdir -p shared/src server/src client/src && \
    echo "pub fn dummy() {}" > shared/src/lib.rs && \
    echo "fn main() {}" > server/src/main.rs && \
    echo "fn main() {}" > client/src/main.rs && \
    cargo build --release --bin server || true

# Copy real source and rebuild (only this layer changes on code edits)
COPY shared/ shared/
COPY server/ server/
COPY client/ client/
RUN touch shared/src/lib.rs server/src/main.rs client/src/main.rs && \
    cargo build --release --bin server

# Stage 2: Runtime
FROM debian:trixie-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/server /usr/local/bin/bale-server

ENTRYPOINT ["bale-server"]
