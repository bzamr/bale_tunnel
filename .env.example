#client bot
BALE_CLIENT_BOT_TOKEN=replace_by_your_token
#server bot
BALE_SERVER_BOT_TOKEN=replace_by_your_token
# channel-ID
BALE_CHAT_ID=replace_by_your_channel_id

BALE_API_BASE_URL=https://tapi.bale.ai

# Webhook mode (server only). When set, Bale pushes updates to this URL
# instead of long polling. Must be HTTPS and publicly reachable (ports 80, 88, 443, 8443).
# For local dev, use ngrok: WEBHOOK_BASE_URL=https://your-ngrok-url:8443
WEBHOOK_BASE_URL=https://your-server.com:8443
WEBHOOK_PATH=/webhook
SERVER_PORT=8080

# Max chunk size for buffer
MAX_CHUNK_SIZE_BYTES=1048576
# inactivity timeout to send unfilled buffer
INACTIVITY_TIMEOUT_MS=500
# long polling timeout (second)
POLLING_TIMEOUT_SECONDS=30

# client socks5 address
SOCKS5_LISTEN_ADDR=127.0.0.1:1080
SOCKS5_EXTERNAL_PORT=1080
SOCKS5_CONTAINER_PORT=1080

# log level (trace, debug, info, warn, error)
RUST_LOG=info,client=debug,server=debug
